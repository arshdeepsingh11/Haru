# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres"
# Used only by `npm run db:migrate` (Session pooler / direct, port 5432). Falls back to DATABASE_URL.
DATABASE_URL_MIGRATIONS=""

# ── Auth (Supabase) ──────────────────────────────────────────────────────────
# Supabase → Project Settings → API. The anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── AI (server only) — set ONE of these ──────────────────────────────────────
# Google Gemini: free key at https://aistudio.google.com/apikey
# (free tier: limited requests/day, and Google may use free-tier data to improve its products)
GEMINI_API_KEY=""
# Optional: models tried in order when the main Gemini model is busy (503) or out of quota (429).
# How hard Gemini 3 thinks before answering: minimal | low | medium | high. Lower is faster.
# HARU_AI_THINKING="low"
# HARU_AI_FALLBACK_MODELS="gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash"
# Anthropic Claude: https://console.anthropic.com (paid; API data not used for training)
ANTHROPIC_API_KEY=""
# Optional: force a provider ("gemini" or "anthropic") and/or a model.
# Defaults: gemini-3.8-flash / claude-sonnet-5-5
HARU_AI_PROVIDER=""
HARU_AI_MODEL=""

# ── Web Push (VAPID). Generate with: npm run vapid ───────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact for push services, e.g. mailto:you@example.com or https://your-domain
VAPID_SUBJECT="mailto:you@example.com"

# ── Scheduler ───────────────────────────────────────────────────────────────
# Long random string. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Public URL of the deployment (used in notification links)
NEXT_PUBLIC_APP_URL="https://your-haru.vercel.app"
