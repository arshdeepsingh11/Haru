# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres"
# Used only by `npm run db:migrate` (Session pooler / direct, port 5432). Falls back to DATABASE_URL.
DATABASE_URL_MIGRATIONS=""

# ── Auth (Supabase) ──────────────────────────────────────────────────────────
# Supabase → Project Settings → API. The anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── AI (server only) ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# Optional override. Defaults to claude-sonnet-5-5.
HARU_AI_MODEL=""

# ── Web Push (VAPID). Generate with: npm run vapid ───────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact for push services, e.g. mailto:you@example.com or https://your-domain
VAPID_SUBJECT="mailto:you@example.com"

# ── Scheduler ───────────────────────────────────────────────────────────────
# Long random string. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Public URL of the deployment (used in notification links)
NEXT_PUBLIC_APP_URL="https://your-haru.vercel.app"
