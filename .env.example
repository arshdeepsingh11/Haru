# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres"
# Used only by `npm run db:migrate` (Session pooler / direct, port 5432). Falls back to DATABASE_URL.
DATABASE_URL_MIGRATIONS=""

# ── Auth (Supabase) ──────────────────────────────────────────────────────────
# Supabase → Project Settings → API. The anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── AI (server only) ────────────────────────────────────────────────────────
# Claude (Anthropic) is used first when its key is set: the most careful at saving
# jobs, paydays and shifts correctly. Key: https://console.anthropic.com (paid per use).
ANTHROPIC_API_KEY=""
# Optional. Default claude-opus-5-5 (best). claude-sonnet-5-5 is cheaper and faster.
# HARU_CLAUDE_MODEL="claude-opus-5-5"
# Google Gemini: free key at https://aistudio.google.com/apikey
# With both keys, Gemini is the automatic backup if Claude is down or busy.
GEMINI_API_KEY=""
# HARU_GEMINI_MODEL="gemini-3.8-flash"
# Gemini models tried when the main Gemini model is busy (503) or out of quota (429).
# HARU_AI_FALLBACK_MODELS="gemini-3.6-flash,gemini-2.5-flash"
# How hard Gemini 3 thinks before answering: minimal | low | medium | high.
# HARU_AI_THINKING="low"
# Optional: force one provider ("anthropic" or "gemini"); "off" disables switching to the other.
HARU_AI_PROVIDER=""
# HARU_AI_CROSS_FALLBACK="off"

# ── Invest tab: market data and news (all optional, server only) ──────────────
# Without keys the Invest tab still shows news, Bank of Canada rates/FX and India mutual-fund NAVs.
# Twelve Data (free, 800 calls/day): US stocks/ETFs, FX, crypto, gold/silver live. https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=""
# Alpha Vantage (free, 25 calls/day): BSE (India) and TSX (Canada) end-of-day history. https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=""
# EODHD (paid, optional): delayed NSE/TSX quotes and the Nifty/Sensex/TSX indexes. https://eodhd.com
EODHD_API_KEY=""
# New York Times Top Stories API (free, optional; RSS works without it). https://developer.nytimes.com
NYT_API_KEY=""

# ── Web Push (VAPID). Generate with: npm run vapid ───────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact for push services, e.g. mailto:you@example.com or https://your-domain
VAPID_SUBJECT="mailto:you@example.com"

# ── Scheduler ───────────────────────────────────────────────────────────────
# Long random string. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Public URL of the deployment (used in notification links)
NEXT_PUBLIC_APP_URL="https://your-haru.vercel.app"
